<% layout("/layouts/boilerplate") -%>

    <body>
        <div class="row mt-4 mb-5">
            <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
                <div class="card shadow border-0" style="border-radius: 1rem; overflow: hidden;">
                    <div class="card-header"
                        style="background: linear-gradient(135deg, #fe424d, #ff6b75); color: white; padding: 1.5rem;">
                        <h2 class="mb-0"><i class="fa-solid fa-pen-to-square"></i> Edit Your Listing</h2>
                    </div>
                    <div class="card-body p-4">
                        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="needs-validation"
                            novalidate enctype="multipart/form-data">

                            <div class="mb-4">
                                <label for="title" class="form-label"><i class="fa-solid fa-heading"></i> Title</label>
                                <input type="text" name="listing[title]" value="<%= listing.title %>"
                                    class="form-control" required>
                                <div class="valid-feedback">This Title looks Good.</div>
                            </div>

                            <div class="mb-4">
                                <label for="description" class="form-label"><i class="fa-solid fa-align-left"></i>
                                    Description</label>
                                <textarea name="listing[description]" class="form-control" rows="4"
                                    required> <%= listing.description %> </textarea>
                                <div class="invalid-feedback">Please enter a short Description.</div>
                            </div>


                            <div class="mb-4">
                                <label class="form-label"><i class="fa-solid fa-image"></i> Current Image</label><br>
                                <img src="<%= originalImageURL %>" alt="Image of Listing" class="img-thumbnail"
                                    style="height: 200px; width: auto; max-width: 100%; border-radius: 0.75rem;">
                            </div>


                            <div class="mb-4">
                                <label for="image" class="form-label"><i class="fa-solid fa-upload"></i> Upload New
                                    Image</label>
                                <input type="file" class="form-control" name="listing[image]"
                                    value="<%= listing.image %>">
                            </div>

                            <div class="mb-4">
                                <label for="category" class="form-label"><i class="fa-solid fa-list"></i> Category</label>
                                <select name="listing[category]" class="form-control" required>
                                    <option value="Trending" <%= listing.category === 'Trending' ? 'selected' : '' %>>Trending</option>
                                    <option value="Rooms" <%= listing.category === 'Rooms' ? 'selected' : '' %>>Rooms</option>
                                    <option value="Iconic Cities" <%= listing.category === 'Iconic Cities' ? 'selected' : '' %>>Iconic Cities</option>
                                    <option value="Mountains" <%= listing.category === 'Mountains' ? 'selected' : '' %>>Mountains</option>
                                    <option value="Castles" <%= listing.category === 'Castles' ? 'selected' : '' %>>Castles</option>
                                    <option value="Amazing Pools" <%= listing.category === 'Amazing Pools' ? 'selected' : '' %>>Amazing Pools</option>
                                    <option value="Camping" <%= listing.category === 'Camping' ? 'selected' : '' %>>Camping</option>
                                    <option value="Farms" <%= listing.category === 'Farms' ? 'selected' : '' %>>Farms</option>
                                    <option value="Arctic" <%= listing.category === 'Arctic' ? 'selected' : '' %>>Arctic</option>
                                    <option value="Beach" <%= listing.category === 'Beach' ? 'selected' : '' %>>Beach</option>
                                </select>
                                <div class="invalid-feedback">Please select a category.</div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-md-4 mb-4">
                                    <label for="price" class="form-label"><i class="fa-solid fa-indian-rupee-sign"></i>
                                        Price</label>
                                    <input type="number" name="listing[price]" value="<%= listing.price %>"
                                        class="form-control" required>
                                    <div class="invalid-feedback">Price should be valid.</div>
                                </div>

                                <div class="col-12 col-md-8 mb-4">
                                    <label for="country" class="form-label"><i class="fa-solid fa-earth-americas"></i>
                                        Country</label>
                                    <input type="text" name="listing[country]" class="form-control" required
                                        value="<%= listing.country %>">
                                    <div class="invalid-feedback">Country name should be valid.</div>
                                </div>

                            </div>
                            <div class="mb-4">
                                <label for="location" class="form-label"><i class="fa-solid fa-location-dot"></i>
                                    Location</label>
                                <input type="text" name="listing[location]" value="<%= listing.location %>"
                                    class="form-control" required>
                                <div class="invalid-feedback">Location should be valid.</div>
                            </div>

                            <button class="btn btn-lg w-100 edit-btn">
                                <i class="fa-solid fa-check"></i> Update Listing
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </body>